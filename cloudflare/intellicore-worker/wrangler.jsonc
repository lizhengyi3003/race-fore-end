{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intellicore-worker",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
